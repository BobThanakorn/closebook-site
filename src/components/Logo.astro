---
import { SITE } from 'astrowind:config';
---

<span class="flex items-center gap-2 ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-heading whitespace-nowrap">
  <svg width="30" height="30" viewBox="0 0 40 40" role="img" aria-label="Closebook logo">
    <rect width="40" height="40" rx="10" fill="#13262B"></rect>
    <path
      d="M8 12.5c4-1.8 8-1.8 12 .8 4-2.6 8-2.6 12-.8v15.2c-4-1.8-8-1.8-12 .8-4-2.6-8-2.6-12-.8z"
      fill="#F7F5F0"></path>
    <path d="M20 13.4v15.1" stroke="#13262B" stroke-width="1.2"></path>
    <path
      d="M23 21.4l2.6 2.6 4.6-5.2"
      stroke="#B5441C"
      stroke-width="2.3"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  {SITE?.name}
</span>
